:root {
  --chat-header-height: 130px;
}

@import "tailwindcss";
@import "../design-system/theme.css";

html,
body {
  height: 100%;
  overflow: hidden;
}

:root {
  --background: var(--color-ink);
  --foreground: var(--color-off-white);
}

html {
  font-family: var(--font-sans);
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: inherit;
  margin: 0;
}
