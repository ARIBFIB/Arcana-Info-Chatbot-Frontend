"use client";

import type { ReactNode } from "react";

import { FadeIn } from "@/components/animations";

import { useChat } from "../_context/chat-context";
import { ChatBackground } from "./ChatBackground";
import { ChatHeader } from "./ChatHeader";
import { ChatMainArea } from "./ChatMainArea";
import { ChatSidebar } from "./ChatSidebar";

type ChatLayoutProps = {
  children: ReactNode;
};

export function ChatLayout({ children }: ChatLayoutProps) {
  const {
    deleteModal,
    sidebarOpen,
    toggleSidebar,
    isDesktop,
    isLoggedIn,
    sessionUuid,
    chatHistory,
    conversationTitle,
    authModalOpen,
    setAuthModalOpen,
    handleNewChat,
    handleSelectChat,
    handleSlideUpdate,
    handleRenameHistory,
    handleDeleteHistory,
    mainRef,
    handleAuthSuccess,
  } = useChat();

  return (
    <div className="flex min-h-screen w-full overflow-x-hidden">
      {deleteModal}

      {isLoggedIn && !isDesktop && sidebarOpen && (
        <button
          type="button"
          aria-label="Close sidebar"
          className="fixed inset-0 z-850 bg-black/45 backdrop-blur-[2px] lg:hidden"
          onClick={toggleSidebar}
        />
      )}

      {isLoggedIn && (
        <ChatSidebar
          isOpen={sidebarOpen}
          activeId={sessionUuid}
          history={chatHistory}
          onNewChat={handleNewChat}
          onSelectChat={handleSelectChat}
          onSlideUpdate={handleSlideUpdate}
          onRenameChat={handleRenameHistory}
          onDeleteChat={handleDeleteHistory}
        />
      )}

      <div ref={mainRef} className="flex-1 min-w-0">
        <ChatBackground>
          <FadeIn duration={0.4} delay={0}>
            <ChatHeader
              onToggleSidebar={toggleSidebar}
              showSidebarToggle={isLoggedIn}
              conversationTitle={conversationTitle}
              activeChatId={sessionUuid}
              authModalOpen={authModalOpen}
              onAuthModalOpenChange={setAuthModalOpen}
              onAuthSuccess={handleAuthSuccess}
            />
          </FadeIn>

          <ChatMainArea>{children}</ChatMainArea>
        </ChatBackground>
      </div>
    </div>
  );
}
